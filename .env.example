# Hostinger SMTP (SSL/TLS on port 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true

# Mailbox credentials from Hostinger → Emails → Manage → Configuration
SMTP_USER=info@oradentalwellness.com
SMTP_PASS=your-mailbox-password

# Sender and recipient for form notifications
SMTP_FROM=info@oradentalwellness.com
SMTP_TO=info@oradentalwellness.com

# Google Places API (New) — live reviews, rating, and review count
# 1. Create a key in Google Cloud Console with Places API (New) enabled
# 2. Find your Place ID: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_PLACE_ID=ChIJ...your-place-id

# Cloudflare Workers local dev: copy these values into `.dev.vars` as well.
